# Hosted Postgres connection string (e.g. from Neon, Supabase, or Vercel Postgres)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-fresh-random-secret"

# Optional: Vercel Blob Store für Produktbilder/Videos (ohne Token: Base64-Fallback in der DB)
BLOB_READ_WRITE_TOKEN=

# Optional: Resend-API-Key für echte Transaktions-E-Mails (ohne Key: kein Versand, nur In-App-Benachrichtigungen)
RESEND_API_KEY=
